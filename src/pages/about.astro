---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const experience = [
  {
    company: "Conduit",
    role: "Software Engineer",
    period: "Apr 2026 - Present",
    location: "Remote",
    description:
      "Software Engineer on the Rollups Team, working on rollup infrastructure.",
    url: "https://conduit.xyz",
  },
  {
    company: "thirdweb",
    role: "Software Engineer",
    period: "Jul 2024 - Nov 2025",
    location: "Remote / SF",
    description:
      "Worked on Engine, the web3 backend builders have been dreaming of. Sophisticated nonce management for transaction inclusion at scale across chains, smart backend wallets, KMS integration. Also designed and built Vault, a non-custodial key management service secured with AWS Nitro Enclaves.",
  },
  {
    company: "Zoniqx",
    role: "Lead Architect",
    period: "Jul 2022 - Jun 2024",
    location: "Hyderabad / Remote",
    description:
      "Led a major project rewrite, co-authored ERC-7518 for dynamic compliance rules processing. Built the first compliant RWA tokenization layer on XRPL. Architected Heimdall (enterprise web3 operational layer) and CompliTO (globally compliant security token transfers).",
  },
  {
    company: "Biconomy",
    role: "Software Engineer",
    period: "Nov 2021 - May 2022",
    location: "Dubai / Remote",
    description:
      "Built and shipped 3 platforms in 3 months. Led the gasless infrastructure revamp processing millions of transactions for clients like JP Morgan. Built the world's first multichain ERC-4337 smart contract wallet as a weekend hackathon POC.",
  },
  {
    company: "Libertas Network",
    role: "Senior Fullstack Developer",
    period: "Mar 2021 - Nov 2021",
    location: "London / Remote",
    description:
      "First full-time role. Built a blockchain-based decentralized censorship-resistant podcasting platform using IPFS, Node, and Ethereum.",
  },
];
---

<Base
  title="About d4mr | Prithvish Baidya — Systems Engineer"
  description="About d4mr (Prithvish Baidya) — Systems engineer building decentralized systems and developer tools. Rust, web3, blockchain."
>
  <div class="max-w-2xl mx-auto px-6 py-12 md:py-20">
    <Header activeSection="about" />

    <section class="mb-12 animate-fade-up stagger-1">
      <p class="font-serif text-lg md:text-xl leading-relaxed font-light">
        I'm a systems engineer, currently at <a href="https://conduit.xyz" target="_blank" rel="noopener" class="link-underline">Conduit</a> working on rollup infrastructure.
        Most of my work lives somewhere between
        <span class="italic text-stone-600 dark:text-stone-400">cryptography</span>,
        <span class="italic text-stone-600 dark:text-stone-400">distributed systems</span>, and
        <span class="italic text-stone-600 dark:text-stone-400">developer experience</span>.
      </p>
    </section>

    <section class="mb-16 animate-fade-up stagger-2">
      <p class="font-serif text-base md:text-lg leading-relaxed text-stone-500">
        Some highlights: won
        <a href="https://x.com/ETHIndiaco/status/1866098806758252987" target="_blank" rel="noopener" class="text-[var(--text)] link-underline">ETHIndia 2024</a>
        with zkRail, coauthored
        <a href="https://eips.ethereum.org/EIPS/eip-7518" target="_blank" rel="noopener" class="text-[var(--text)] link-underline">ERC-7518</a>
        for globally compliant RWA tokenization, built the first
        <span class="italic text-stone-600 dark:text-stone-400">ERC-4337</span>
        multichain wallet, and developed core infrastructure for
        <span class="italic text-stone-600 dark:text-stone-400">EIP-7702</span> and
        <span class="italic text-stone-600 dark:text-stone-400">EIP-2771</span>
        meta-transaction relayers.
      </p>
      <p class="mt-4">
        <a href="/story" class="font-mono text-sm link-underline text-[var(--text-muted)]">
          How I got here &rarr;
        </a>
      </p>
    </section>

    <!-- Divider -->
    <div class="mb-16 h-px bg-[var(--border)] animate-fade-in stagger-2"></div>

    <article class="animate-fade-up stagger-3">
      <!-- Experience -->
      <section>
        <h2
          class="font-mono text-xs tracking-widest uppercase text-[var(--text-muted)] mb-8"
        >
          Experience
        </h2>

        <div class="space-y-8">
          {
            experience.map((job, i) => (
              <div
                class:list={[
                  "border-l-2 border-[var(--border)] pl-6 animate-fade-up",
                  `stagger-${Math.min(i + 3, 6)}`,
                ]}
              >
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
                  <h3 class="font-serif text-lg">
                    {job.company}{" "}
                    <span class="text-[var(--text-muted)]">/ {job.role}</span>
                  </h3>
                  <span class="font-mono text-xs text-[var(--text-faint)]">
                    {job.period}
                  </span>
                </div>
                <p class="font-mono text-xs text-[var(--text-muted)] mb-3">
                  {job.location}
                </p>
                <p class="font-serif text-sm text-stone-500 leading-relaxed">
                  {job.description}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Awards -->
      <section class="mt-16">
        <h2
          class="font-mono text-xs tracking-widest uppercase text-[var(--text-muted)] mb-8"
        >
          Awards
        </h2>

        <div class="space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
            <div>
              <a href="https://x.com/ETHIndiaco/status/1866098806758252987" target="_blank" rel="noopener" class="font-serif text-lg link-underline">
                ETHIndia 2024 Winner
              </a>
              <p class="font-serif text-sm text-stone-500 mt-1">
                1st place with zkRail, ZK-powered UPI to crypto rails
              </p>
            </div>
            <span class="font-mono text-xs text-[var(--text-faint)]">Dec 2024</span>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
            <div>
              <a href="/projects/t2z" class="font-serif text-lg link-underline">
                Zypherpunk 2025 Winner
              </a>
              <p class="font-serif text-sm text-stone-500 mt-1">
                1st place ECC track, plus Tachyon, Raybot, Network School bounties with t2z
              </p>
            </div>
            <span class="font-mono text-xs text-[var(--text-faint)]">Jan 2025</span>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
            <div>
              <span class="font-serif text-lg">KVPY-SA Fellowship</span>
              <p class="font-serif text-sm text-stone-500 mt-1">
                Kishore Vaigyanik Protsahan Yojana, national science fellowship by IISc
              </p>
            </div>
            <span class="font-mono text-xs text-[var(--text-faint)]">Nov 2019</span>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
            <div>
              <span class="font-serif text-lg">NTSE Scholar</span>
              <p class="font-serif text-sm text-stone-500 mt-1">
                National Talent Search Examination, top 1000 nationally
              </p>
            </div>
            <span class="font-mono text-xs text-[var(--text-faint)]">Feb 2019</span>
          </div>
        </div>
      </section>

      <!-- Publications -->
      <section class="mt-16">
        <h2
          class="font-mono text-xs tracking-widest uppercase text-[var(--text-muted)] mb-8"
        >
          Publications
        </h2>

        <div class="space-y-6">
          <div>
            <a href="https://eips.ethereum.org/EIPS/eip-7518" target="_blank" rel="noopener" class="font-serif text-lg link-underline">
              ERC-7518: Dynamic Compliant Interop Security Token
            </a>
            <p class="font-serif text-sm text-stone-500 mt-1">
              Ethereum standard for compliant real-world asset tokenization with dynamic transfer restrictions, partition-based rights management, and cross-chain interoperability.
            </p>
            <span class="font-mono text-xs text-[var(--text-faint)]">Draft, Ethereum EIPs</span>
          </div>
        </div>
      </section>

      <!-- Stack -->
      <section class="mt-16">
        <h2
          class="font-mono text-xs tracking-widest uppercase text-[var(--text-muted)] mb-6"
        >
          Stack
        </h2>

        <div class="grid gap-4 font-mono text-sm">
          <div>
            <span class="text-[var(--text-muted)]">Systems</span>
            <span class="text-[var(--text-faint)]"> / </span>
            <span>Rust, Go, TypeScript, PostgreSQL, Redis, Kafka</span>
          </div>
          <div>
            <span class="text-[var(--text-muted)]">Cryptography</span>
            <span class="text-[var(--text-faint)]"> / </span>
            <span>ZK (Halo 2, Noir), Zcash/Orchard, WASM, TEE/Nitro Enclaves</span>
          </div>
          <div>
            <span class="text-[var(--text-muted)]">Web3</span>
            <span class="text-[var(--text-faint)]"> / </span>
            <span>Solidity, Viem, ERC-4337, EIP-2771, L2/Rollups</span>
          </div>
          <div>
            <span class="text-[var(--text-muted)]">Frontend</span>
            <span class="text-[var(--text-faint)]"> / </span>
            <span>React, Next.js, Tailwind, Tanstack</span>
          </div>
        </div>
      </section>

      <!-- Elsewhere -->
      <section class="mt-16 pt-8 border-t border-[var(--border)]">
        <h2
          class="font-mono text-xs tracking-widest uppercase text-[var(--text-muted)] mb-4"
        >
          Elsewhere
        </h2>
        <ul class="space-y-2 font-mono text-sm">
          <li>
            <a
              href="/resume.pdf"
              class="link-underline"
            >
              Resume (PDF)
            </a>
          </li>
          <li>
            <a
              href="https://x.com/earth_ish"
              class="link-underline"
              target="_blank"
              rel="noopener"
            >
              X (@earth_ish)
            </a>
          </li>
          <li>
            <a
              href="https://github.com/d4mr"
              class="link-underline"
              target="_blank"
              rel="noopener"
            >
              GitHub
            </a>
          </li>
          <li>
            <a
              href="https://linkedin.com/in/prithvish-baidya"
              class="link-underline"
              target="_blank"
              rel="noopener"
            >
              LinkedIn
            </a>
          </li>
        </ul>
      </section>
    </article>

    <div class="mt-20">
      <Footer />
    </div>
  </div>
</Base>
