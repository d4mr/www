---
import { getTweet } from "react-tweet/api";
import { EmbeddedTweet, TweetNotFound } from "react-tweet";
import "react-tweet/theme.css";

interface Props {
  id: string;
}

const { id } = Astro.props;

let tweet;
let error = false;

try {
  tweet = await getTweet(id);
} catch (e) {
  console.error(`Failed to fetch tweet ${id}:`, e);
  error = true;
}
---

<div class="tweet-container not-prose my-6 flex justify-center">
  {error || !tweet ? (
    <TweetNotFound />
  ) : (
    <EmbeddedTweet tweet={tweet} />
  )}
</div>

<style is:global>
  /* Override react-tweet theme to match site */
  .tweet-container {
    --tweet-font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --tweet-font-color: var(--text);
    --tweet-font-color-secondary: var(--text-muted);
    --tweet-bg-color: var(--bg-paper);
    --tweet-bg-color-hover: var(--bg);
    --tweet-border: 1px solid var(--border);
    --tweet-color-blue-primary: #1d9bf0;
    --tweet-twitter-icon-color: var(--text);
  }

  .tweet-container .react-tweet-theme {
    margin: 0 !important;
    max-width: 550px;
    width: 100%;
  }

  /* Kill prose link underline background-image */
  .prose .tweet-container a,
  .tweet-container a {
    background-image: none !important;
    background-size: unset !important;
    text-decoration: none !important;
    color: inherit;
  }

  .prose .tweet-container a:hover,
  .tweet-container a:hover {
    background-image: none !important;
    text-decoration: underline !important;
  }

  /* Kill prose img styles */
  .prose .tweet-container img,
  .tweet-container img {
    margin: 0 !important;
    border-radius: 0 !important;
  }

  /* Avatar should be round */
  .tweet-container [data-testid="tweet-user-avatar"] img {
    border-radius: 9999px !important;
  }

  /* Reset other prose interference */
  .prose .tweet-container p,
  .tweet-container p {
    margin: 0 !important;
    margin-bottom: 0 !important;
    font-family: var(--tweet-font-family) !important;
    font-size: inherit !important;
    line-height: inherit !important;
    font-weight: 400 !important;
  }

  .prose .tweet-container blockquote,
  .tweet-container blockquote {
    border-left: none !important;
    padding-left: 0 !important;
    font-style: normal !important;
    color: inherit !important;
    margin: 0 !important;
  }
</style>
